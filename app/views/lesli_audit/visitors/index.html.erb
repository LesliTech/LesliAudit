
<%
traffic = @traffic.reverse
top_days = traffic.last(3)
%>

<%= render(LesliView::Layout::Container.new("audit-analytics")) do %>
    <%= render(LesliView::Components::Header.new("Analytics")) %>

    <section
        class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5"
        aria-label="Traffic overview">
        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="text-sm font-medium text-slate-500">Controllers</h2>
            <p class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 tabular-nums">
                <%= @visits[:controllers] %>
            </p>
        </article>

        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="text-sm font-medium text-slate-500">Requests</h2>
            <p class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 tabular-nums">
                <%= @visits[:requests] %>
            </p>
        </article>

        <% top_days.each do |day| %>
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <h2 class="text-sm font-medium text-slate-500"><%= day["xaxiskey"] %></h2>
                <p class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 tabular-nums">
                    <%= day["yaxiskey"] %>
                </p>
            </article>
        <% end %>
    </section>

    <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <%= render(LesliView::Charts::Line.new(
            database_to_dataset: traffic,
            title: "Requests"
        )) %>
    </section>

    <section class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-3" aria-label="Request traffic breakdown">
        <article class="min-w-0">
            <%= render(LesliView::Elements::Table.new(
                columns: [
                    { label: "Browsers", align: :left },
                    { label: "Requests", align: :center }
                ],
                class_name: "!min-w-0",
                compact: true,
                caption: "Requests by browser"
            )) do |table| %>
                <% @browsers.each do |browser| %>
                    <% percentage = browser[:percentage].to_i.clamp(0, 100) %>
                    <% table.with_row do |row| %>
                        <% row.with_cell(class_name: "!p-0") do %>
                            <div class="relative isolate overflow-hidden px-3 py-2.5">
                                <span
                                    class="absolute inset-y-0 left-0 -z-10 bg-slate-100"
                                    style="width: <%= percentage %>%"
                                    aria-hidden="true"></span>
                                <span class="flex items-center gap-2 text-slate-700">
                                    <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center text-slate-500">
                                        <span class="ri-<%= browser[:icon] %> text-lg leading-none" aria-hidden="true"></span>
                                    </span>
                                    <span class="truncate"><%= browser[:browser] %></span>
                                </span>
                            </div>
                        <% end %>
                        <% row.with_cell(class_name: "font-semibold tabular-nums text-slate-900", align: :center) do %>
                            <%= browser[:count] %>
                        <% end %>
                    <% end %>
                <% end %>
            <% end %>
        </article>

        <article class="min-w-0">
            <%= render(LesliView::Elements::Table.new(
                columns: [
                    { label: "OS", align: :left },
                    { label: "Requests", align: :center }
                ],
                class_name: "!min-w-0",
                compact: true,
                caption: "Requests by operating system"
            )) do |table| %>
                <% @os.each do |device| %>
                    <% percentage = device[:percentage].to_i.clamp(0, 100) %>
                    <% table.with_row do |row| %>
                        <% row.with_cell(class_name: "!p-0") do %>
                            <div class="relative isolate overflow-hidden px-3 py-2.5">
                                <span
                                    class="absolute inset-y-0 left-0 -z-10 bg-slate-100"
                                    style="width: <%= percentage %>%"
                                    aria-hidden="true"></span>
                                <span class="flex items-center gap-2 text-slate-700">
                                    <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center text-slate-500">
                                        <span class="ri-<%= device[:icon].downcase %> text-lg leading-none" aria-hidden="true"></span>
                                    </span>
                                    <span class="truncate"><%= device[:device] %></span>
                                </span>
                            </div>
                        <% end %>
                        <% row.with_cell(class_name: "font-semibold tabular-nums text-slate-900", align: :center) do %>
                            <%= device[:count] %>
                        <% end %>
                    <% end %>
                <% end %>
            <% end %>
        </article>

        <article class="min-w-0">
            <%= render(LesliView::Elements::Table.new(
                columns: [
                    { label: "Device", align: :left },
                    { label: "Requests", align: :center }
                ],
                class_name: "!min-w-0",
                compact: true,
                caption: "Requests by device"
            )) do |table| %>
                <% @devices.each do |device| %>
                    <% percentage = device[:percentage].to_i.clamp(0, 100) %>
                    <% table.with_row do |row| %>
                        <% row.with_cell(class_name: "!p-0") do %>
                            <div class="relative isolate overflow-hidden px-3 py-2.5">
                                <span
                                    class="absolute inset-y-0 left-0 -z-10 bg-slate-100"
                                    style="width: <%= percentage %>%"
                                    aria-hidden="true"></span>
                                <span class="flex items-center gap-2 text-slate-700">
                                    <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center text-slate-500">
                                        <span class="ri-<%= device[:icon] %> text-lg leading-none" aria-hidden="true"></span>
                                    </span>
                                    <span class="truncate"><%= device[:device] %></span>
                                </span>
                            </div>
                        <% end %>
                        <% row.with_cell(class_name: "font-semibold tabular-nums text-slate-900", align: :center) do %>
                            <%= device[:count] %>
                        <% end %>
                    <% end %>
                <% end %>
            <% end %>
        </article>
    </section>

    <section class="mt-6 pb-8" aria-label="Top controllers">
        <%= render(LesliView::Elements::Table.new(
            columns: [{
                label: "Top controllers",
                field: "request_controller"
            }, {
                label: "Requests",
                field: "requests"
            }],
            records: @requests,
            caption: "Requests by controller"
        )) %>
    </section>
<% end %>
