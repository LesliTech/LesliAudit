<%= render(LesliView::Layout::Container.new("audit-requests")) do %>
    <%= render(LesliView::Components::Header.new(
        t("lesli_audit.requests.title", default: "Requests")
    )) %>

    <%= render(LesliView::Components::Toolbar.new(
        t("lesli_audit.requests.search_placeholder", default: "Search by user, controller, or action"),
        url: lesli_audit.requests_path
    )) do |toolbar| %>
        <% toolbar.with_filters do %>
            <%= label_tag :orderBy, t("lesli_audit.requests.sort_by", default: "Sort by"), class: "sr-only" %>
            <%= select_tag :orderBy, options_for_select([
                [t("lesli_audit.requests.columns_date", default: "Date"), "date"],
                [t("lesli_audit.requests.columns_count", default: "Count"), "count"],
                [t("lesli_audit.requests.columns_user", default: "User"), "user"],
                [t("lesli_audit.requests.columns_controller", default: "Controller"), "controller"],
                [t("lesli_audit.requests.columns_action", default: "Action"), "action"]
            ], params[:orderBy].presence || "date"),
                class: "rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700" %>

            <%= label_tag :order, t("lesli_audit.requests.direction", default: "Direction"), class: "sr-only" %>
            <%= select_tag :order, options_for_select([
                [t("lesli_audit.requests.descending", default: "Descending"), "desc"],
                [t("lesli_audit.requests.ascending", default: "Ascending"), "asc"]
            ], params[:order].presence || "desc"),
                class: "rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700" %>

            <%= label_tag :perPage, t("lesli_audit.requests.per_page", default: "Results per page"), class: "sr-only" %>
            <%= select_tag :perPage, options_for_select([12, 25, 50, 100], params[:perPage].presence || 12),
                class: "rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700" %>
        <% end %>
    <% end %>

    <%= render(LesliView::Elements::Table.new(
        columns: [
            {
                label: t("lesli_audit.requests.columns_user", default: "User"),
                field: "user_email"
            }, {
                label: t("lesli_audit.requests.columns_controller", default: "Controller"),
                field: "request_controller"
            }, {
                label: t("lesli_audit.requests.columns_action", default: "Action"),
                field: "request_action"
            }, {
                label: t("lesli_audit.requests.columns_count", default: "Count"),
                field: "request_count",
                align: :center
            }, {
                label: t("lesli_audit.requests.columns_date", default: "Date"),
                field: "date"
            }
        ],
        records: @requests[:records],
        caption: t("lesli_audit.requests.caption", default: "Aggregated user requests"),
        empty: t("lesli_audit.requests.empty", default: "No requests found")
    )) %>

    <% pagination = @requests.fetch(:pagination) %>
    <% if pagination[:total].positive? %>
        <nav class="mt-4 flex items-center justify-between gap-4" aria-label="<%= t("lesli_audit.requests.pagination", default: "Requests pagination") %>">
            <div>
                <% if pagination[:page] > 1 %>
                    <%= link_to t("lesli_audit.requests.previous", default: "Previous"),
                        lesli_audit.requests_path(request.query_parameters.merge(page: pagination[:page] - 1)),
                        class: "text-sm font-medium text-sky-700 hover:text-sky-900" %>
                <% end %>
            </div>

            <p class="text-sm text-slate-600">
                <%= t("lesli_audit.requests.page", default: "Page %{page} of %{pages}",
                    page: pagination[:page], pages: pagination[:pages]) %>
            </p>

            <div>
                <% if pagination[:page] < pagination[:pages] %>
                    <%= link_to t("lesli_audit.requests.next", default: "Next"),
                        lesli_audit.requests_path(request.query_parameters.merge(page: pagination[:page] + 1)),
                        class: "text-sm font-medium text-sky-700 hover:text-sky-900" %>
                <% end %>
            </div>
        </nav>
    <% end %>
<% end %>
