<%= render(LesliView::Layout::Container.new("audit-log")) do %>
    <%= render(LesliView::Components::Header.new(
        t("lesli_audit.logs.show_title", default: "Audit event"),
        t("lesli_audit.logs.kinds.#{@log_kind}", default: @log_kind.humanize),
        back: lesli_audit.logs_path(kind: @log_kind)
    )) %>

    <% fields = %i[
        engine
        source
        action
        operation
        description
        actor_uid
        session_id
        subject_type
        subject_id
        created_at
    ] %>

    <dl class="grid grid-cols-1 gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-2">
        <% fields.each do |field| %>
            <div>
                <dt class="text-sm font-medium text-slate-500">
                    <%= t("lesli_audit.logs.fields.#{field}", default: field.to_s.humanize) %>
                </dt>
                <dd class="mt-1 break-words text-sm text-slate-900">
                    <%= @log.public_send(field).presence || t("lesli_audit.logs.not_available", default: "Not available") %>
                </dd>
            </div>
        <% end %>
    </dl>
<% end %>
