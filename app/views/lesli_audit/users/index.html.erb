
<%= render(LesliView::Layout::Container.new("audit-users")) do %>
    <%= render(LesliView::Components::Header.new("Users")) %>

    <pre><code><%= dd @users %></code></pre>

    <div class="columns">
        <% @users[:overview].each do |overview| %>
            <div class="column">
                <div class="box">
                    <h4><%= overview[:label] %></h4>
                    <p class="is-size-3"><%= overview[:value] %></p>
                    <small><%= overview[:percentage] %>%</small>
                </div>
            </div>
        <% end %>
    </div>

    <div class="columns">
        <div class="column is-8">
            <div class="box">
            <%= render(LesliView::Elements::Table.new(columns: [])) do |table| %>
                <% @users[:distribution].each do |user| %>
                    <% table.with_row(css_class:"is-white") do |row| %>
                        <% row.with_cell(css_class:"") do %>
                            <%= user[:label] %>
                        <% end %>
                        <% row.with_cell(css_class:"p-0 is-fullwidth") do %>
                            <p style="padding:8px;border-radius:4px;background:<%= user[:color] %>;width:<%= user[:percentage] %>%">
                            </p>
                        <% end %>
                        <% row.with_cell(css_class:"has-text-right") do %>
                            <%= user[:value] %>
                        <% end %>
                        <% row.with_cell(css_class:"has-text-right") do %>
                            <span class="has-text-grey-light has-text-weight-bold">
                                <%= user[:percentage] %>%
                            </span>
                        <% end %>
                    <% end %>
                <% end %>
            <% end %>
            </div>
        </div>
    </div>

    <div class="columns">
        <div class="column">
            <%= render(LesliView::Elements::Table.new(
                columns: [{
                    label: "id",
                    field: "user_id"
                },{
                    label: "User",
                    field: "user_email"
                },{
                    label:"First activity",
                    field:"first_activity"
                },{
                    label:"Last activity",
                    field:"last_activity"
                },{
                    label:"Resources",
                    field:"resources"
                },{
                    label:"Requests",
                    field:"requests"
                },{
                    label:"Date",
                    field:"date"
                }],
                records: @working_hours
            )) %>
        </div>
    </div>

    <br>
<% end %>
