
<%
color_classes = {
    "info" => "text-sky-600",
    "warning" => "text-amber-600",
    "danger" => "text-rose-600"
}.freeze
%>

<%= render(LesliView::Layout::Container.new("audit-users")) do %>
    <%= render(LesliView::Components::Header.new("Users")) %>

    <section
        class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5"
        aria-label="User overview">
        <% @users[:overview].each do |user| %>
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <h2 class="text-sm font-medium text-slate-500"><%= user[:label] %></h2>
                <p class="mt-3 text-3xl font-semibold tracking-tight tabular-nums <%= color_classes.fetch(user[:color], "text-slate-700") %>">
                    <%= user[:value] %>
                </p>
            </article>
        <% end %>
    </section>

    <section class="mt-6 lg:w-2/5" aria-label="Users needing attention">
        <%= render(LesliView::Elements::Table.new(
            columns: [],
            headless: true,
            striped: false,
            compact: true,
            class_name: "!min-w-0",
            caption: "Users needing attention"
        )) do |table| %>
            <% @users[:attention_needed].each do |user| %>
                <% table.with_row do |row| %>
                    <% row.with_cell do %>
                        <span class="inline-flex h-8 w-8 items-center justify-center <%= color_classes.fetch(user[:color], "text-slate-500") %>">
                            <span class="ri-<%= user[:icon] %> text-xl leading-none" aria-hidden="true"></span>
                        </span>
                    <% end %>
                    <% row.with_cell(class_name: "w-full font-medium text-slate-700") do %>
                        <%= user[:label] %>
                    <% end %>
                    <% row.with_cell(class_name: "font-semibold tabular-nums text-slate-900", align: :right) do %>
                        <%= user[:value] %>
                    <% end %>
                <% end %>
            <% end %>
        <% end %>
    </section>

    <section class="mt-6 pb-8" aria-label="User working hours">
        <%= render(LesliView::Elements::Table.new(
            columns: [{
                label: "id",
                field: "user_id"
            }, {
                label: "User",
                field: "user_email"
            }, {
                label: "First activity",
                field: "first_activity"
            }, {
                label: "Last activity",
                field: "last_activity"
            }, {
                label: "Requests",
                field: "requests"
            }, {
                label: "Date",
                field: "date"
            }],
            records: @working_hours,
            caption: "User working hours"
        )) %>
    </section>
<% end %>
