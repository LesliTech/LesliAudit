
<%= render(LesliView::Layout::Container.new("audit-users")) do %>
    <%= render(LesliView::Components::Header.new("Users")) %>

    <div class="columns">
        <% @users[:overview].each do |user| %>
            <div class="column">
                <div class="box">
                    <h4><%= user[:label] %></h4>
                    <p class="is-size-3 has-text-<%= user[:color] %>"><%= user[:value] %></p>
                </div>
            </div>
        <% end %>
    </div>

    <div class="columns">    
        <div class="column">
            <div class="box">
                <%= render(LesliView::Elements::Table.new(columns: [])) do |table| %>
                    <% @users[:attention_needed].each do |user| %>
                        <% table.with_row do |row| %>
                            <% row.with_cell do %>
                                <span class="icon has-text-<%= user[:color] %>">
                                    <span class="is-size-4 ri-<%= user[:icon] %>"></span>
                                </span>
                            <% end %>
                            <% row.with_cell(class_name: "w-full") do %>
                                <%= user[:label] %>
                            <% end %>
                            <% row.with_cell(align: :right) do %>
                                <span class="is-size-6 has-text-weight-bold">
                                    <%= user[:value] %>
                                </span>
                            <% end %>
                        <% end %>
                    <% end %>
                <% end %>
            </div>
        </div>
        <div class="column is-three-fifths">
        </div>
    </div>

    <div class="columns">
        <div class="column">
            <%= render(LesliView::Elements::Table.new(
                columns: [{
                    label: "id",
                    field: "user_id"
                },{
                    label: "User",
                    field: "user_email"
                },{
                    label:"First activity",
                    field:"first_activity"
                },{
                    label:"Last activity",
                    field:"last_activity"
                },{
                    label:"Resources",
                    field:"resources"
                },{
                    label:"Requests",
                    field:"requests"
                },{
                    label:"Date",
                    field:"date"
                }],
                records: @working_hours
            )) %>
        </div>
    </div>

    <br>
<% end %>
