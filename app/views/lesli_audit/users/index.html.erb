
<%
color_classes = {
    "info" => "text-sky-600",
    "warning" => "text-amber-600",
    "danger" => "text-rose-600"
}.freeze

summary_cards = [
    {
        key: :registered,
        label: t("lesli_audit.users.registered", default: "Registered users"),
        color: "info"
    }, {
        key: :enabled,
        label: t("lesli_audit.users.enabled", default: "Enabled users"),
        color: "info"
    }, {
        key: :active_last_30_days,
        label: t("lesli_audit.users.active_last_30_days", default: "Active in the last 30 days"),
        color: "info"
    }, {
        key: :deactivated,
        label: t("lesli_audit.users.deactivated", default: "Deactivated users"),
        color: "warning"
    }, {
        key: :deleted,
        label: t("lesli_audit.users.deleted", default: "Deleted users"),
        color: "danger"
    }
].freeze

attention_rows = [
    {
        key: :unconfirmed,
        label: t("lesli_audit.users.unconfirmed", default: "Unconfirmed users"),
        color: "warning",
        icon: "user-add-line"
    }, {
        key: :never_signed_in,
        label: t("lesli_audit.users.never_signed_in", default: "Never signed in"),
        color: "warning",
        icon: "time-line"
    }, {
        key: :failed_sign_ins,
        label: t("lesli_audit.users.failed_sign_ins", default: "Users with failed sign-ins"),
        color: "danger",
        icon: "shield-keyhole-line"
    }, {
        key: :locked,
        label: t("lesli_audit.users.locked", default: "Locked users"),
        color: "danger",
        icon: "lock-line"
    }
].freeze
%>

<%= render(LesliView::Layout::Container.new("audit-users")) do %>
    <%= render(LesliView::Components::Header.new(
        t("lesli_audit.users.title", default: "Users"),
        t("lesli_audit.users.subtitle", default: "Account registrations, status, and observed working hours")
    )) %>

    <section
        class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5"
        aria-label="<%= t("lesli_audit.users.overview", default: "User overview") %>">
        <% summary_cards.each do |card| %>
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <h2 class="text-sm font-medium text-slate-500"><%= card[:label] %></h2>
                <p class="mt-3 text-3xl font-semibold tracking-tight tabular-nums <%= color_classes.fetch(card[:color]) %>">
                    <%= @summary.fetch(card[:key]) %>
                </p>
            </article>
        <% end %>
    </section>

    <section class="mt-6 lg:w-2/5" aria-label="<%= t("lesli_audit.users.attention", default: "Users needing attention") %>">
        <article class="min-w-0">
            <%= render(LesliView::Elements::Table.new(
                columns: [],
                headless: true,
                striped: false,
                compact: true,
                class_name: "!min-w-0",
                caption: t("lesli_audit.users.attention", default: "Users needing attention")
            )) do |table| %>
                <% attention_rows.each do |item| %>
                    <% table.with_row do |row| %>
                        <% row.with_cell do %>
                            <span class="inline-flex h-8 w-8 items-center justify-center <%= color_classes.fetch(item[:color]) %>">
                                <span class="ri-<%= item[:icon] %> text-xl leading-none" aria-hidden="true"></span>
                            </span>
                        <% end %>
                        <% row.with_cell(class_name: "w-full font-medium text-slate-700") do %>
                            <%= item[:label] %>
                        <% end %>
                        <% row.with_cell(class_name: "font-semibold tabular-nums text-slate-900", align: :right) do %>
                            <%= @attention.fetch(item[:key]) %>
                        <% end %>
                    <% end %>
                <% end %>
            <% end %>
        </article>
    </section>

    <section class="mt-6 w-full rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <%= render(LesliView::Charts::Line.new(
            database_to_dataset: @registrations,
            title: t("lesli_audit.users.registrations", default: "Registrations during the last 12 months")
        )) %>
    </section>

    <section
        class="mt-6 pb-8"
        aria-label="<%= t("lesli_audit.users.working_hours", default: "Observed working hours") %>">
        <%= render(LesliView::Elements::Table.new(
            columns: [{
                label: t("lesli_audit.users.user", default: "User"),
                field: "user_email"
            }, {
                label: t("lesli_audit.users.first_activity", default: "First activity"),
                field: "first_activity"
            }, {
                label: t("lesli_audit.users.last_activity", default: "Last activity"),
                field: "last_activity"
            }, {
                label: t("lesli_audit.users.date", default: "Date"),
                field: "date"
            }],
            records: @working_hours,
            caption: t("lesli_audit.users.working_hours_caption", default: "First and last retained activity per user and day during the last 30 days"),
            empty: t("lesli_audit.users.no_activity", default: "No retained user activity was found")
        )) %>
    </section>
<% end %>
