
<%
request_trend = @request_trend.reverse
top_days = request_trend.last(3)
%>

<%= render(LesliView::Layout::Container.new("audit-analytics")) do %>
    <%= render(LesliView::Components::Header.new(
        t("lesli_audit.analytics.title", default: "Analytics")
    )) %>

    <section
        class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5"
        aria-label="<%= t("lesli_audit.analytics.overview", default: "Authenticated usage overview") %>">
        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="text-sm font-medium text-slate-500">
                <%= t("lesli_audit.analytics.controllers", default: "Controllers") %>
            </h2>
            <p class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 tabular-nums">
                <%= @summary[:controllers] %>
            </p>
        </article>

        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="text-sm font-medium text-slate-500">
                <%= t("lesli_audit.analytics.requests", default: "Requests") %>
            </h2>
            <p class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 tabular-nums">
                <%= @summary[:requests] %>
            </p>
        </article>

        <% top_days.each do |day| %>
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <h2 class="text-sm font-medium text-slate-500"><%= day["xaxiskey"] %></h2>
                <p class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 tabular-nums">
                    <%= day["yaxiskey"] %>
                </p>
            </article>
        <% end %>
    </section>

    <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <%= render(LesliView::Charts::Line.new(
            database_to_dataset: request_trend,
            title: t("lesli_audit.analytics.requests", default: "Requests")
        )) %>
    </section>

    <section
        class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-3"
        aria-label="<%= t("lesli_audit.analytics.login_breakdown", default: "Successful login breakdown") %>">
        <article class="min-w-0">
            <%= render(LesliView::Elements::Table.new(
                columns: [
                    { label: t("lesli_audit.analytics.browsers", default: "Browsers"), align: :left },
                    { label: t("lesli_audit.analytics.logins", default: "Logins"), align: :center }
                ],
                class_name: "!min-w-0",
                compact: true,
                caption: t("lesli_audit.analytics.logins_by_browser", default: "Successful logins by browser")
            )) do |table| %>
                <% @browsers.each do |browser| %>
                    <% percentage = browser[:percentage].to_i.clamp(0, 100) %>
                    <% table.with_row do |row| %>
                        <% row.with_cell(class_name: "!p-0") do %>
                            <div class="relative isolate overflow-hidden px-3 py-2.5">
                                <span
                                    class="absolute inset-y-0 left-0 -z-10 bg-slate-100"
                                    style="width: <%= percentage %>%"
                                    aria-hidden="true"></span>
                                <span class="flex items-center gap-2 text-slate-700">
                                    <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center text-slate-500">
                                        <span class="ri-<%= browser[:icon] %> text-lg leading-none" aria-hidden="true"></span>
                                    </span>
                                    <span class="truncate"><%= browser[:browser] %></span>
                                </span>
                            </div>
                        <% end %>
                        <% row.with_cell(class_name: "font-semibold tabular-nums text-slate-900", align: :center) do %>
                            <%= browser[:count] %>
                        <% end %>
                    <% end %>
                <% end %>
            <% end %>
        </article>

        <article class="min-w-0">
            <%= render(LesliView::Elements::Table.new(
                columns: [
                    { label: t("lesli_audit.analytics.operating_systems", default: "OS"), align: :left },
                    { label: t("lesli_audit.analytics.logins", default: "Logins"), align: :center }
                ],
                class_name: "!min-w-0",
                compact: true,
                caption: t("lesli_audit.analytics.logins_by_operating_system", default: "Successful logins by operating system")
            )) do |table| %>
                <% @operating_systems.each do |operating_system| %>
                    <% percentage = operating_system[:percentage].to_i.clamp(0, 100) %>
                    <% table.with_row do |row| %>
                        <% row.with_cell(class_name: "!p-0") do %>
                            <div class="relative isolate overflow-hidden px-3 py-2.5">
                                <span
                                    class="absolute inset-y-0 left-0 -z-10 bg-slate-100"
                                    style="width: <%= percentage %>%"
                                    aria-hidden="true"></span>
                                <span class="flex items-center gap-2 text-slate-700">
                                    <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center text-slate-500">
                                        <span class="ri-<%= operating_system[:icon].downcase %> text-lg leading-none" aria-hidden="true"></span>
                                    </span>
                                    <span class="truncate"><%= operating_system[:operating_system] %></span>
                                </span>
                            </div>
                        <% end %>
                        <% row.with_cell(class_name: "font-semibold tabular-nums text-slate-900", align: :center) do %>
                            <%= operating_system[:count] %>
                        <% end %>
                    <% end %>
                <% end %>
            <% end %>
        </article>

        <article class="min-w-0">
            <%= render(LesliView::Elements::Table.new(
                columns: [
                    { label: t("lesli_audit.analytics.devices", default: "Devices"), align: :left },
                    { label: t("lesli_audit.analytics.logins", default: "Logins"), align: :center }
                ],
                class_name: "!min-w-0",
                compact: true,
                caption: t("lesli_audit.analytics.logins_by_device", default: "Successful logins by device")
            )) do |table| %>
                <% @devices.each do |device| %>
                    <% percentage = device[:percentage].to_i.clamp(0, 100) %>
                    <% table.with_row do |row| %>
                        <% row.with_cell(class_name: "!p-0") do %>
                            <div class="relative isolate overflow-hidden px-3 py-2.5">
                                <span
                                    class="absolute inset-y-0 left-0 -z-10 bg-slate-100"
                                    style="width: <%= percentage %>%"
                                    aria-hidden="true"></span>
                                <span class="flex items-center gap-2 text-slate-700">
                                    <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center text-slate-500">
                                        <span class="ri-<%= device[:icon] %> text-lg leading-none" aria-hidden="true"></span>
                                    </span>
                                    <span class="truncate"><%= device[:device] %></span>
                                </span>
                            </div>
                        <% end %>
                        <% row.with_cell(class_name: "font-semibold tabular-nums text-slate-900", align: :center) do %>
                            <%= device[:count] %>
                        <% end %>
                    <% end %>
                <% end %>
            <% end %>
        </article>
    </section>

    <section
        class="mt-6 pb-8"
        aria-label="<%= t("lesli_audit.analytics.top_controllers", default: "Top controllers") %>">
        <%= render(LesliView::Elements::Table.new(
            columns: [{
                label: t("lesli_audit.analytics.top_controllers", default: "Top controllers"),
                field: "request_controller"
            }, {
                label: t("lesli_audit.analytics.requests", default: "Requests"),
                field: "requests"
            }],
            records: @top_controllers,
            caption: t("lesli_audit.analytics.requests_by_controller", default: "Requests by controller")
        )) %>
    </section>
<% end %>
