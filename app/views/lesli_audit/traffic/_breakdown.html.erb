<article class="min-w-0 rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm">
    <h2 class="mb-4 text-base font-semibold text-neutral-900"><%= title %></h2>

    <% if records.any? %>
        <%= render(LesliView::Elements::Table.new(
            columns: [
                { label: title, align: :left },
                { label: t("lesli_audit.traffic.page_views", default: "Page views"), align: :center },
                { label: t("lesli_audit.traffic.visits", default: "Visits"), align: :center },
                { label: t("lesli_audit.traffic.percentage", default: "Percentage"), align: :center }
            ],
            class_name: "!min-w-0",
            compact: true,
            caption: title
        )) do |table| %>
            <% records.each do |record| %>
                <% table.with_row do |row| %>
                    <% row.with_cell(class_name: "!p-0") do %>
                        <div class="relative isolate overflow-hidden px-3 py-2.5">
                            <span
                                class="absolute inset-y-0 left-0 -z-10 bg-neutral-100"
                                style="width: <%= record[:percentage].to_f.clamp(0, 100) %>%"
                                aria-hidden="true"></span>
                            <span class="block truncate text-neutral-700">
                                <%= record[:other] ? t("lesli_audit.traffic.other", default: "Other") : record[:value] %>
                            </span>
                        </div>
                    <% end %>
                    <% row.with_cell(class_name: "font-semibold tabular-nums text-neutral-900", align: :center) do %>
                        <%= number_with_delimiter(record[:page_views]) %>
                    <% end %>
                    <% row.with_cell(class_name: "tabular-nums text-neutral-600", align: :center) do %>
                        <%= number_with_delimiter(record[:visits]) %>
                    <% end %>
                    <% row.with_cell(class_name: "tabular-nums text-neutral-600", align: :center) do %>
                        <%= number_to_percentage(record[:percentage], precision: 1, strip_insignificant_zeros: true) %>
                    <% end %>
                <% end %>
            <% end %>
        <% end %>
    <% else %>
        <p class="text-sm text-neutral-500">
            <%= t("lesli_audit.traffic.no_breakdown", default: "No breakdown data is available for this period.") %>
        </p>
    <% end %>
</article>
